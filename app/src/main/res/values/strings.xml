    <string name="notif_cleanup_reminder_title">Daily blast in 30 minutes</string>
    <plurals name="notif_cleanup_reminder_text">
        <item quantity="one">%d archived screenshot will be detonated at the daily blast.</item>
        <item quantity="other">%d archived screenshots will be detonated at the daily blast.</item>
    </plurals>

    <string name="onboarding_intro">Every screenshot lands armed. Defuse the keepers, stage the maybes for the daily blast, or light a fuse and walk away. Everything stays on this device.</string>
    <string name="onboarding_optional_hint">optional</string>
    <string name="onboarding_degraded_title">Popups will be quieter</string>
    <string name="onboarding_degraded_body">Without notifications or full-screen popup access, armed screenshots wait silently in the list instead. You can grant access any time in Settings or system settings.</string>
    <string name="onboarding_enable_janitor">Arm The Bomb</string>
    <string name="onboarding_not_now">Not now</string>

    <string name="perm_images_title">Photos and videos access</string>
    <string name="perm_images_body">Required. The Bomb needs to see new screenshots to list them, show thumbnails, and detonate them on your command. Nothing is uploaded — the app has no internet permission at all.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">Used for the instant screenshot popup with Defuse / Archive / Detonate buttons, and optional blast reminders.</string>
    <string name="perm_fsi_title">Full-screen popups</string>
    <string name="perm_fsi_body">Lets the screenshot popup appear over the lock screen, like an incoming call. On Android 14 this must be granted in system settings; the app works without it, showing a normal heads-up notification instead.</string>
    <string name="perm_battery_title">Battery optimization exemption</string>
    <string name="perm_battery_body">Optional. Battery savers can delay fuse timers by a few minutes. Exempting The Bomb keeps detonations punctual. The app never begs for this.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_body">Optional. Lets the popup appear instantly even while you are using the phone. Without it, the popup still appears when the screen is off or locked, and a heads-up notification covers the rest.</string>
    <string name="perm_state_granted">Granted</string>
    <string name="perm_state_denied">Denied</string>
    <string name="perm_action_grant">Grant</string>
    <string name="perm_action_open_settings">Open settings</string>

    <string name="card_permission_images_title">Screenshot access needed</string>
    <string name="card_permission_images_body">The Bomb can\'t see screenshots without photo access, so nothing is being tracked right now.</string>
    <string name="card_permission_notifications_title">Notifications are off</string>
    <string name="card_permission_notifications_body">You\'ll miss the instant popup. Screenshots are still tracked and detonated on schedule.</string>
    <string name="card_permission_fsi_title">Popups restricted by Android 14</string>
    <string name="card_permission_fsi_body">Full-screen popup access isn\'t granted. Tap to allow it in system settings — it\'s the switch labeled \"Full-screen intents\".</string>
    <string name="card_permission_battery_title">Fuses may run late</string>
    <string name="card_permission_battery_body">Battery optimization can push fuse timers back by a few minutes. Exempt The Bomb for punctual detonations.</string>

