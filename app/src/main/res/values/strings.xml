    <string name="app_name">The Bomb</string>

    <string name="notif_channel_service_name">Bomb watcher</string>
    <string name="notif_channel_service_desc">Persistent status for the real-time screenshot watcher. Silent.</string>
    <string name="notif_channel_screenshot_name">New screenshots</string>
    <string name="notif_channel_screenshot_desc">Pops up the moment a screenshot lands, with Defuse / Archive / Detonate actions.</string>
    <string name="notif_channel_reminder_name">Daily blast reminders</string>
    <string name="notif_channel_reminder_desc">Optional heads-up before the daily blast runs.</string>
    <string name="notif_channel_consent_name">Detonations needing approval</string>
    <string name="notif_channel_consent_desc">Android requires your approval to delete screenshots; tap to approve.</string>

    <string name="notif_service_title">The Bomb is armed</string>
    <string name="notif_service_text">Watching for new screenshots — each one lands armed. Tap to open.</string>

